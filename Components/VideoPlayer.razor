@using AdamFlix.Models
@using AdamFlix.Services
@inject IVideoParserService VideoParser
@inject IJSRuntime JS

<div id="@PlayerId" class="relative aspect-video w-full rounded-2xl overflow-hidden bg-black shadow-2xl border border-[#1E2638] group select-none">
    @if (Analysis.IsIframe)
    {
        <iframe src="@Analysis.ResolvedUrl"
                title="@Title"
                class="w-full h-full border-0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen>
        </iframe>
    }
    else
    {
        <video id="@($"{PlayerId}_video")"
               src="@Analysis.ResolvedUrl"
               poster="@Poster"
               controls
               class="w-full h-full object-contain">
        </video>
    }

    <div class="absolute top-3 left-3 bg-black/70 backdrop-blur-md px-2.5 py-1 rounded-lg border border-white/10 text-[10px] text-[#00D4FF] font-mono">
        @Analysis.DetectedPlatform
    </div>
</div>

@code {
    [Parameter] public string SourceUrl { get; set; } = "";
    [Parameter] public string Poster { get; set; } = "";
    [Parameter] public string Title { get; set; } = "AdamFlix Cinema Stream";
    [Parameter] public string PlayerId { get; set; } = $"player_{Guid.NewGuid().ToString("N").Substring(0, 8)}";

    private VideoSourceAnalysis Analysis = new();

    protected override void OnParametersSet()
    {
        Analysis = VideoParser.ParseSource(SourceUrl);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Analysis.IsIframe && !string.IsNullOrEmpty(Analysis.ResolvedUrl))
        {
            await JS.InvokeVoidAsync("AdamFlixPlayer.init", $"{PlayerId}_video", Analysis.ResolvedUrl);
        }
    }
}
